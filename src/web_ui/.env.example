# Read-side Controller API prefix; blank means no live API is configured.
# The /v1/* API contract must be implemented by the controller web service.
VITE_CONTROLLER_API_BASE_URL=
# Optional development-only fixture preview; disabled by default.
VITE_PREVIEW_DATA=false
# UI rejects control measurements older than this age (milliseconds).
VITE_LIVE_MAX_AGE_MS=5000

VITE_CONTROLLER_HEALTH_URL=/api/health/controller
VITE_COMMANDER_HEALTH_URL=/api/health/commander
VITE_BROKER_HEALTH_URL=/api/health/broker
